# SNIP Environment Variables
# Copy to apps/web/.env.local and fill in values.
# NEVER commit real secrets.

# -----------------------------------------------------------------------------
# Supabase (public — safe for browser & Flutter)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Flutter uses the same public values (see apps/mobile/lib/config/env.dart)
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# Supabase (server-only — NEVER expose to Flutter or client bundles)
# -----------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# -----------------------------------------------------------------------------
# Resend (server-only)
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=SNIP <bookings@yourdomain.com>

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
